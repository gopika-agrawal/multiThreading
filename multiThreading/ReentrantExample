package multiThreading;

import java.util.concurrent.locks.Lock;

import java.util.concurrent.locks.ReentrantLock;

public class ReentrantExample {
	
	private final Lock lock = new ReentrantLock();
	
	public void outerMethod() {
		lock.lock();
		try {
			System.out.println("Outer Method");
			innerMethod();
		}
		finally {
			lock.unlock();
		}
	}
	
	public void innerMethod() {
		lock.lock();    // here we have a single thread which is main, and that thread try to acquire the lock again which is possible because of reentrantLock so the flow of the program will go normal and lock counter will start as it will count how many times the lock has been used...
		try {
			System.out.println("Inner Method");
		}
		finally {
			lock.unlock();
		}
	}
	
	public static void main(String[] args) {
		ReentrantExample example = new ReentrantExample();
		example.outerMethod();
	}
	
}
