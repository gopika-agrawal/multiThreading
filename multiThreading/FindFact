package multiThreading;

import java.util.*;
import java.util.concurrent.*;

public class FindFact {
	
	public static void main(String[] args) {
		ScheduledExecutorService scheduler = Executors.newScheduledThreadPool(1);
		
//		scheduler.schedule(() -> System.out.println("Task executed after five seconds delay"), 5, TimeUnit.SECONDS);
		
		scheduler.scheduleAtFixedRate(() -> System.out.println("Task executed after every five seconds"), 5, 5, TimeUnit.SECONDS);
		
		ScheduledFuture<?> scheduledFuture = scheduler.scheduleWithFixedDelay(() -> System.out.println("Task executed after every five seconds"), 5, 5, TimeUnit.SECONDS);
		
		scheduler.schedule(() -> {
			System.out.println("Initiating shutdown...");
			scheduler.shutdown();
		}, 20, TimeUnit.SECONDS);
		
	}
	
}
